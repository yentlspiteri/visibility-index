# Copy this file to .env.local for local dev with `vercel dev`.
# In production, set these values in Vercel → Project → Settings → Environment Variables.
# DO NOT commit .env.local — it's gitignored.

# Anthropic Claude (brand-clarity scoring)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Apify (LinkedIn profile data) — replaced ProxyCurl after LinkedIn's lawsuit shut Proxycurl down
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — change which Apify actor we call. Default: dev_fusion~Linkedin-Profile-Scraper
# APIFY_LINKEDIN_ACTOR=dev_fusion~Linkedin-Profile-Scraper

# SerpAPI (Google footprint check)
SERPAPI_API_KEY=xxxxxxxxxxxxxxxx

# Mailchimp
# - API_KEY format is "<32-char>-<server>" e.g. "abc...123-us17"
# - AUDIENCE_ID is found at Audience → Settings → Audience name and defaults
# - SERVER_PREFIX is the subdomain in your Mailchimp dashboard URL (us1, us17, etc.)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us17
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
MAILCHIMP_SERVER_PREFIX=us17

# Resend (transactional email — PDF report delivery, ops alerts, team-audit sign-in & digests)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — audits per IP per hour. Default: 5.
# RATE_LIMIT_PER_HOUR=5

# Notion — log every audit to the "Visibility Index Audits" database.
# - NOTION_TOKEN is the integration secret from notion.so/profile/integrations.
# - NOTION_AUDITS_DATABASE_ID is the 32-char hex ID in the DB URL.
#   Current DB: https://www.notion.so/vonpeach/fc6af046d436494b9e1255ab6cc7c2ab
#   Share that DB with the integration (DB → ⋯ → Connections) or writes 404.
# If either var is unset, audit logging silently no-ops.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_AUDITS_DATABASE_ID=fc6af046d436494b9e1255ab6cc7c2ab

# ─── Team audit (managers measuring teams in bulk) ─────────────────────────
# Vercel Postgres — provision via Vercel Storage → Create Database → Postgres.
# The integration auto-populates POSTGRES_URL (and friends). Schema is
# created on first request to any /api/manager/* endpoint.
POSTGRES_URL=postgres://...

# Resend transactional sender — magic-link sign-in, opt-in emails, weekly digests.
# Reuses RESEND_API_KEY from above; only override the from-line if you want
# transactional mail to come from a different verified address than ops alerts.
# RESEND_FROM_TRANSACTIONAL=Von Peach <hello@vonpeach.com>

# 32+ char random string. Signs session cookies (HMAC-SHA256). Rotate to log
# every team-audit user out. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32

# Vercel injects this automatically for cron requests as the Authorization
# header. Set to any random string in dev to enable manual triggers via
# ?secret=... on /api/cron/* endpoints.
CRON_SECRET=replace-me-with-any-random-string
