{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/monthly-rescore", "schedule": "0 9 1 * *" },
    { "path": "/api/cron/monthly-digest",  "schedule": "30 9 1 * *" }
  ]
}
